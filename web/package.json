{
  "name": "farm-stream-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && vite preview --host 0.0.0.0",
    "build": "vite build && node scripts/export.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "check:export": "node scripts/check-export.mjs",
    "check:rpc": "tsx scripts/check-rpc.ts",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@uniswap/sdk-core": "7.19.4",
    "@uniswap/v4-sdk": "2.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "viem": "2.56.9"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  }
}
